{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DotfilesScaffoldConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectName"],
  "properties": {
    "projectName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Root package name and default directory label."
    },
    "scope": {
      "type": "string",
      "pattern": "^@[a-z][a-z0-9-]*$",
      "description": "npm workspace scope used for apps and packages (defaults to @projectName)."
    },
    "description": {
      "type": "string"
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["frontend_app", "node_backend"]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["tsconfig", "types", "util"]
      }
    }
  }
}
