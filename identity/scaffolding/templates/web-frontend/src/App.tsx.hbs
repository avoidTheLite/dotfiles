import { useEffect, useState } from 'react';
import type { JSX } from 'react';
import type { HelloResponse } from '{{scope}}/types';
import { Button } from './components/ui/Button.tsx';
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from './components/ui/Card.tsx';

const loadHello = async (): Promise<string> => {
  const response = await fetch('/api/hello');
  if (!response.ok) {
    throw new Error(`API returned ${response.status}`);
  }
  const payload = (await response.json()) as HelloResponse;
  return payload.message;
};

export const App = (): JSX.Element => {
  const [message, setMessage] = useState('Loading…');

  const refresh = (): void => {
    void loadHello()
      .then(setMessage)
      .catch(() => {
        setMessage('API is not running. Start the Node service (apps/api) and retry.');
      });
  };

  useEffect(() => {
    refresh();
  }, []);

  return (
    <main className="flex min-h-screen items-center justify-center bg-background p-8 text-foreground">
      <Card className="max-w-xl">
        <CardHeader>
          <CardDescription className="uppercase tracking-wide">{{projectName}}</CardDescription>
          <CardTitle>React app is ready</CardTitle>
        </CardHeader>
        <CardContent className="space-y-4">
          <p className="text-muted-foreground">{message}</p>
          <Button type="button" onClick={refresh}>
            Retry API
          </Button>
        </CardContent>
      </Card>
    </main>
  );
};
