import pino from 'pino';
import { getCorrelationId } from './requestContext.ts';

export const createLogger = (context: { module: string; level?: string }): pino.Logger => {
  const { level = process.env.LOG_LEVEL ?? 'info', ...childContext } = context;
  return pino({
    level,
    timestamp: pino.stdTimeFunctions.isoTime,
    mixin(): { correlationId?: string } {
      const correlationId = getCorrelationId();
      return correlationId ? { correlationId } : {};
    },
  }).child(childContext);
};
